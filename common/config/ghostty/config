# This is the configuration file for Ghostty.
#
# Run `ghostty +show-config --default --docs` to view a list of
# all available config options and their default values.
#
# Additionally, each config option is also explained in detail
# on Ghostty's website, at https://ghostty.org/docs/config.
#
# ctrl-shift-, to reload
# Base theme — used on machines without Omarchy (e.g. macOS).
theme = catppuccin-mocha.conf
# theme = "Catppuccin Latte"

# On Omarchy, override the base theme with the current Omarchy theme. This file
# is regenerated by `omarchy theme set`, which then SIGUSR2s Ghostty to reload.
# The `?` prefix makes it optional so non-Omarchy machines don't error.
config-file = ?"~/.local/state/omarchy/current/theme/ghostty.conf"

window-padding-x = 16,16
window-padding-y = 16,16
window-decoration = "none"
background-opacity = 0.9
background-blur-radius = 20

# Apply background-opacity even to cells with an explicit background color.
# Without this, tmux/neovim repaint the whole screen with an opaque theme
# background and transparency/blur is lost the moment they start.
background-opacity-cells = true

font-family = "MesloLGS Nerd Font Mono"
font-size = 12

# Launch fish explicitly rather than relying on $SHELL/passwd — a running
# graphical session keeps the shell that was active at login until you log
# out and back in, so this makes new windows correct immediately.
command = fish

# macOS font rendering improvements (no effect on Linux)
# strength is a value between 0 and 255
font-thicken = true
font-thicken-strength = 100

clipboard-read = allow
clipboard-write = allow

# macOS Cmd+C / Cmd+V.
keybind = super+c=copy_to_clipboard
keybind = super+v=paste_from_clipboard

# On Omarchy the super+* binds above never fire: Hyprland's global SUPER+V /
# SUPER+C "universal" shortcuts intercept them and, for terminal windows,
# synthesize Shift+Insert / Ctrl+Insert. Ghostty's built-in shift+insert is
# paste_from_selection (PRIMARY), so a tmux `y` yank (which writes the CLIPBOARD
# via OSC 52) wouldn't paste back. Map both to the clipboard.
keybind = shift+insert=paste_from_clipboard
keybind = control+insert=copy_to_clipboard

keybind = ctrl+0=text:\x1b[48;5u
keybind = ctrl+1=text:\x1b[49;5u
keybind = ctrl+2=text:\x1b[50;5u
keybind = ctrl+3=text:\x1b[51;5u
keybind = ctrl+4=text:\x1b[52;5u
keybind = ctrl+5=text:\x1b[53;5u
