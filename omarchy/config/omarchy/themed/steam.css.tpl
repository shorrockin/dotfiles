/* Generated by Omarchy from the active theme. Loaded by Millennium. */
:root {
  color-scheme: {{ mode }} !important;
  accent-color: {{ accent }} !important;

  --omarchy-steam-bg: {{ background }};
  --omarchy-steam-bg-dark: {{ dark_background }};
  --omarchy-steam-bg-darker: {{ darker_background }};
  --omarchy-steam-bg-light: {{ lighter_background }};
  --omarchy-steam-selection: {{ selection }};
  --omarchy-steam-fg: {{ foreground }};
  --omarchy-steam-fg-soft: {{ light_foreground }};
  --omarchy-steam-muted: {{ muted }};
  --omarchy-steam-accent: {{ accent }};
  --omarchy-steam-accent-bright: {{ bright_blue }};
  --omarchy-steam-danger: {{ red }};
  --omarchy-steam-success: {{ green }};

  /* Steam-owned variables that currently have stable semantic names. */
  --main-text-color: {{ foreground }} !important;
  --main-light-blue-background: {{ accent }} !important;
  --main-text-on-light-blue: {{ darker_background }} !important;
  --main-top-image-bg: {{ darker_background }} !important;
  --main-editor-bg-color: {{ dark_background }} !important;
  --main-editor-input-bg-color: {{ lighter_background }} !important;
  --main-editor-text-color: {{ foreground }} !important;
  --main-editor-section-title-color: {{ light_foreground }} !important;
  --menu-background: {{ dark_background }} !important;
  --virtualmenu-accent: {{ accent }} !important;
  --virtualmenu-bg: {{ dark_background }} !important;
  --virtualmenu-bg-hover: {{ selection }} !important;
  --virtualmenu-fg: {{ foreground }} !important;
}

