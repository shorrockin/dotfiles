.DialogContent,
.DialogContentTransition,
.DesktopUI .DialogContent,
.friendsui-container .DialogContent {
  background: var(--omarchy-steam-bg) !important;
  color: var(--omarchy-steam-fg) !important;
}

.DialogTextInputBase,
._DialogInputContainer,
.DesktopUI .DialogTextInputBase,
.friendsui-container .DialogTextInputBase {
  background: var(--omarchy-steam-bg-light) !important;
  color: var(--omarchy-steam-fg) !important;
  border-color: var(--omarchy-steam-muted) !important;
}

button.DialogButton {
  background: var(--omarchy-steam-bg-light) !important;
  color: var(--omarchy-steam-fg) !important;
}

button.DialogButton:hover,
button.DialogButton.gpfocus,
.DesktopUI .title-area-icon:hover,
.friendsui-container .title-area-icon:hover {
  background: var(--omarchy-steam-selection) !important;
  color: var(--omarchy-steam-fg) !important;
}

button.DialogButton.Primary,
.DialogToggleField_Option.Active,
.DialogSlider_Value,
.DialogProgressBar_Value {
  background: var(--omarchy-steam-accent) !important;
  color: var(--omarchy-steam-bg-darker) !important;
}

button.DialogButton.GreenPlay,
button.DialogButton.GreenPlay:hover,
button.DialogButton.GreenPlay.gpfocus {
  background: var(--omarchy-steam-success) !important;
  color: var(--omarchy-steam-bg-darker) !important;
}

.DesktopUI .title-area-icon.closeButton:hover,
.friendsui-container .title-area-icon.closeButton:hover {
  background: var(--omarchy-steam-danger) !important;
}

::selection {
  background: var(--omarchy-steam-selection) !important;
  color: var(--omarchy-steam-fg) !important;
}

::-webkit-scrollbar-thumb {
  background-color: var(--omarchy-steam-muted) !important;
}

::-webkit-scrollbar-thumb:hover {
  background-color: var(--omarchy-steam-accent) !important;
}
