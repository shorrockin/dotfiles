#!/usr/bin/env bash

set -e

# Configurable base directory
DOTFILES_DIR=~/dotfiles

# Default action is "stow"
USER_ACTION=${1:-stow}  # Accepts: stow, restow, delete

case "$USER_ACTION" in
  stow|restow|delete)
    echo "Action is valid: $USER_ACTION"
    ;;
  *)
    echo "Usage: $0 [stow|restow|delete]"
    exit 1
    ;;
esac

# Detect platform
if [[ "$OSTYPE" == "darwin"* ]]; then
  PLATFORM="macos"
elif [ -d /usr/share/omarchy ]; then
  PLATFORM="omarchy"
else
  PLATFORM="linux"
fi

echo "Platform: $PLATFORM"

# Stow refuses to link over a pre-existing real file/dir (e.g. stock configs
# on a fresh install). Rather than hard-failing, move those aside so stow can
# proceed — never deletes anything, just renames with a timestamp suffix.
resolve_stow_conflicts() {
  local dir="$1" target="$2" pkg="$3"
  shift 3
  local ignore_args=("$@")

  for _ in 1 2 3 4 5; do
    local output
    output=$(stow -n --dir="$dir" --target="$target" "${ignore_args[@]}" "$pkg" 2>&1) || true

    local conflicts
    conflicts=$(printf '%s\n' "$output" | sed -n 's/.*over existing target \(.*\) since neither a link.*/\1/p')
    [ -z "$conflicts" ] && return 0

    while IFS= read -r rel; do
      [ -z "$rel" ] && continue
      local full="$target/$rel"
      if [ -e "$full" ] && [ ! -L "$full" ]; then
        local backup="${full}.pre-stow-backup.$(date +%s)"
        echo "  Existing config would conflict, backing up: $full → $backup"
        mkdir -p "$(dirname "$backup")"
        mv "$full" "$backup"
      fi
    done <<< "$conflicts"
  done

  echo "Warning: could not resolve all stow conflicts for '$pkg' after several passes." >&2
}

# Creating the ~/.config directory for nvim, scripts, etc
mkdir -p ~/.config

# Creating ~/.config/scripts directory so we can link directory to the script, not the directory
mkdir -p ~/.config/scripts

# Creating ~/.config/zsh directory which we will auto-load as part of zshrc
mkdir -p ~/.config/zsh

# Creating ~/.claude directory so we can symlink into it
mkdir -p ~/.claude

# Creating ~/.config/nvim/ directories for lua scripts, so that we don't link nvim wholesale, allowing private modules"
mkdir -p ~/.config/nvim/lua
mkdir -p ~/.config/nvim/lua/lsp
mkdir -p ~/.config/nvim/lua/plugins
mkdir -p ~/.config/nvim/after/plugin
mkdir -p ~/.config/nvim/after/ftplugin
mkdir -p ~/.config/oh-my-posh

echo "Running '$USER_ACTION' for dotfiles..."

# 1. Stow dots/ to home (~)
if [ -d "$DOTFILES_DIR/dots" ]; then
  echo "  $USER_ACTION: dots → $HOME"

  # macOS-only dotfiles (yabai/skhd window management) — skip everywhere else
  MACOS_ONLY_DOTS=("dot-yabairc" "dot-skhdrc")

  DOTS_IGNORE_ARGS=()
  if [[ "$PLATFORM" != "macos" ]]; then
    for file in "${MACOS_ONLY_DOTS[@]}"; do
      DOTS_IGNORE_ARGS+=(--ignore="^${file}$")
    done
  fi

  if [[ "$USER_ACTION" != "delete" ]]; then
    resolve_stow_conflicts "$DOTFILES_DIR" "$HOME" dots --dotfiles "${DOTS_IGNORE_ARGS[@]}"
  fi
  stow --dotfiles --dir="$DOTFILES_DIR" --target="$HOME" "${DOTS_IGNORE_ARGS[@]}" --$USER_ACTION dots
else
  echo "Warning: $DOTFILES_DIR/dots does not exist."
fi

# 2. Stow config/ to ~/.config/ with platform-specific ignores
if [ -d "$DOTFILES_DIR/config" ]; then
  echo "  $USER_ACTION: config → ~/.config"

  # Linux-only directories (skip on macOS)
  LINUX_ONLY=("hypr" "hyprpanel" "waybar" "swaync" "wlogout" "rofi" "walker" "vicinae" "dconf" "quickshell")

  # macOS-only directories (skip on Linux)
  MACOS_ONLY=("aerospace")

  # Raw-Hyprland stack (hypr/bar/launcher/lock/notify) — this is the NixOS
  # profile's manual Hyprland setup. Omarchy ships and owns all of this itself
  # (Lua-based hypr config + its own Quickshell bar/launcher/notifications), so
  # never stow these on Omarchy or they'll sit as dead/conflicting config next
  # to Omarchy's own.
  # fastfetch is here too: our config is NixOS-tailored, and Omarchy's stock
  # fastfetch (no config file — just its built-in default) should stand as-is.
  OMARCHY_EXCLUDE=("hypr" "hyprpanel" "waybar" "swaync" "wlogout" "rofi" "walker" "quickshell" "vicinae" "fastfetch")

  # Files that are NixOS-only regardless of directory (voice dictation is
  # handled by Omarchy's own voxtype there instead)
  OMARCHY_FILE_EXCLUDE=("dictation")

  IGNORE_ARGS=()
  case "$PLATFORM" in
    macos)
      for dir in "${LINUX_ONLY[@]}"; do
        IGNORE_ARGS+=(--ignore="$dir")
      done
      ;;
    omarchy)
      for dir in "${OMARCHY_EXCLUDE[@]}" "${MACOS_ONLY[@]}"; do
        IGNORE_ARGS+=(--ignore="$dir")
      done
      for file in "${OMARCHY_FILE_EXCLUDE[@]}"; do
        IGNORE_ARGS+=(--ignore="^${file}$")
      done
      ;;
    *)
      for dir in "${MACOS_ONLY[@]}"; do
        IGNORE_ARGS+=(--ignore="$dir")
      done
      ;;
  esac

  if [[ "$USER_ACTION" != "delete" ]]; then
    resolve_stow_conflicts "$DOTFILES_DIR" "$HOME/.config" config "${IGNORE_ARGS[@]}"
  fi
  stow --dir="$DOTFILES_DIR" --target="$HOME/.config" "${IGNORE_ARGS[@]}" --$USER_ACTION config
else
  echo "Warning: $DOTFILES_DIR/config does not exist."
fi

# 3. Omarchy-only overrides: small hook files layered on top of Omarchy's own
# defaults (not a full config replacement — see omarchy/install.sh)
if [[ "$PLATFORM" == "omarchy" ]] && [ -d "$DOTFILES_DIR/omarchy" ]; then
  echo "  $USER_ACTION: omarchy → ~/.config"
  if [[ "$USER_ACTION" != "delete" ]]; then
    resolve_stow_conflicts "$DOTFILES_DIR" "$HOME/.config" omarchy
  fi
  stow --dir="$DOTFILES_DIR" --target="$HOME/.config" --$USER_ACTION omarchy
fi
